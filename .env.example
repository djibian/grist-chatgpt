# Development / demo only. Never commit real secrets.
GRIST_BASE_URL=https://grist.example.org
GRIST_API_KEY=
# Deployment resource boundary: configure at least one document ID or workspace ID.
GRIST_ALLOWED_DOCUMENT_IDS=
GRIST_ALLOWED_WORKSPACE_IDS=
# Principal capabilities. Defaults to all three when omitted.
# Allowed: doc:read,doc:write,doc.schema:write
MCP_CAPABILITIES=doc:read,doc:write,doc.schema:write
GPT_ACTION_CAPABILITIES=doc:read,doc:write,doc.schema:write
# Guardrails; 0 means no bridge-side maximum.
GRIST_MAX_READ_RECORDS=5000
GRIST_MAX_WRITE_RECORDS=500
# Total schema items per operation. For table creation, tables + nested initial columns are counted together.
GRIST_MAX_SCHEMA_ITEMS=100
# Large create/update/delete record requests are sent sequentially in batches.
# Batches are not atomic as a group; partial success is reported explicitly.
GRIST_WRITE_BATCH_RECORDS=200
MCP_BEARER_TOKEN=
GPT_ACTION_TOKEN=
# Comma-separated public hostnames accepted by the MCP HTTP endpoint.
# Localhost entries are always added automatically.
MCP_ALLOWED_HOSTS=
PORT=3000
HOST=127.0.0.1
