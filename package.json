{
  "name": "grist-chatgpt",
  "version": "0.5.0",
  "private": true,
  "description": "Controlled compatibility bridge between conversational AI clients and Grist Community.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.poc-tools.json",
    "test": "tsx --test test/*.test.ts",
    "probe:proconnect": "tsx tools/proconnect-mcp-probe.ts",
    "probe:logto": "tsx tools/logto-mcp-probe.ts",
    "probe:oauth-bridge": "tsx tools/oauth-bridge-probe.ts",
    "probe:oauth-negative": "tsx tools/oauth-negative-probe.ts",
    "probe:mcp-http-oauth": "tsx tools/mcp-http-oauth-probe.ts",
    "probe:chatgpt-oauth-readiness": "tsx tools/chatgpt-oauth-readiness-probe.ts",
    "submission:annotations": "tsx tools/plugin-submission-annotations.ts",
    "check:oauth-deployment": "tsx tools/oauth-deployment-preflight.ts",
    "smoke:oauth-deployment": "tsx tools/oauth-operational-smoke.ts",
    "j2:observe-fixture": "node --import tsx tools/j2-access-observe.ts",
    "j2:provision-synthetic-access": "node --import tsx tools/j2-synthetic-access-provision.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
