# Copy to infra/poc/logto/.env and keep the real file out of Git.
# Generate a strong random database password locally.
LOGTO_DB_PASSWORD=replace-with-a-strong-random-value

# Non-production public HTTPS endpoints terminated by your reverse proxy.
# Example names only: choose DNS names you control before running the POC.
LOGTO_ENDPOINT=https://auth-poc.example.org
LOGTO_ADMIN_ENDPOINT=https://auth-poc-admin.example.org
